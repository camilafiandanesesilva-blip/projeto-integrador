    <!-- INICIALIZAÇÃO VLIBRAS -->
    <script>
        window.addEventListener('load', function() {
            if (window.VLibras) {
                new window.VLibras.Widget('https://vlibras.gov.br/app');
            }
        });
    </script>

    <!-- SCRIPTS DO SITE -->
    <script>
        /* ============================================
           ACESSIBILIDADE
           ============================================ */
        function toggleAcessibilidade() {
            const menu = document.getElementById('menuAcessibilidade');
            const btn = document.querySelector('.acessibilidade-toggle');
            const aberto = menu.classList.toggle('aberto');
            btn.setAttribute('aria-expanded', aberto);
        }

        function toggleAltoContraste() {
            document.body.classList.toggle('alto-contraste');
            localStorage.setItem('altoContraste', document.body.classList.contains('alto-contraste'));
        }

        function toggleDislexia() {
            document.body.classList.toggle('modo-dislexia');
            localStorage.setItem('modoDislexia', document.body.classList.contains('modo-dislexia'));
        }

        function toggleFonteGrande() {
            document.body.classList.toggle('fonte-grande');
            localStorage.setItem('fonteGrande', document.body.classList.contains('fonte-grande'));
        }

        function lerTexto() {
            if ('speechSynthesis' in window) {
                const texto = document.getElementById('conteudo-principal').innerText;
                const utterance = new SpeechSynthesisUtterance(texto);
                utterance.lang = 'pt-BR';
                utterance.rate = 0.9;
                speechSynthesis.speak(utterance);
            } else {
                alert('Seu navegador não suporta leitura em voz alta.');
            }
        }

        function abrirVideoLibras(secao) {
            alert(`🤟 Aqui seria exibido um vídeo em Libras explicando a seção: ${secao}\n\n(Estrutura preparada para receber os vídeos reais em produção.)`);
        }

        // Restaurar preferências salvas
        window.addEventListener('load', () => {
            if (localStorage.getItem('altoContraste') === 'true') document.body.classList.add('alto-contraste');
            if (localStorage.getItem('modoDislexia') === 'true') document.body.classList.add('modo-dislexia');
            if (localStorage.getItem('fonteGrande') === 'true') document.body.classList.add('fonte-grande');
        });

        /* ============================================
           SIMULADOR 1: ANIMAÇÃO NTC
           ============================================ */
        const canvasNTC = document.getElementById('canvasNTC');
        const ctxNTC = canvasNTC.getContext('2d');
        const sliderTempNTC = document.getElementById('sliderTempNTC');
        const valorTempNTC = document.getElementById('valorTempNTC');

        let temperaturaNTC = 25;
        let particulas = [];

        // Criar partículas (elétrons)
        for (let i = 0; i < 30; i++) {
            particulas.push({
                x: Math.random() * canvasNTC.width,
                y: Math.random() * canvasNTC.height,
                vx: (Math.random() - 0.5) * 2,
                vy: (Math.random() - 0.5) * 2,
                raio: 4
            });
        }

        function desenharNTC() {
            ctxNTC.clearRect(0, 0, canvasNTC.width, canvasNTC.height);
            
            // Fundo do material (rede cristalina)
            const intensidadeCalor = (temperaturaNTC - 10) / 50;
            const r = Math.floor(200 + intensidadeCalor * 55);
            const g = Math.floor(200 - intensidadeCalor * 150);
            const b = Math.floor(220 - intensidadeCalor * 180);
            ctxNTC.fillStyle = `rgb(${r}, ${g}, ${b})`;
            ctxNTC.fillRect(0, 0, canvasNTC.width, canvasNTC.height);

            // Rede cristalina (átomos fixos)
            ctxNTC.fillStyle = 'rgba(50, 50, 50, 0.6)';
            for (let x = 30; x < canvasNTC.width; x += 60) {
                for (let y = 30; y < canvasNTC.height; y += 60) {
                    const vibracao = intensidadeCalor * 3;
                    const dx = (Math.random() - 0.5) * vibracao;
                    const dy = (Math.random() - 0.5) * vibracao;
                    ctxNTC.beginPath();
                    ctxNTC.arc(x + dx, y + dy, 8, 0, Math.PI * 2);
                    ctxNTC.fill();
                }
            }

            // Elétrons livres (movem-se mais rápido com mais calor)
            const velocidade = 1 + intensidadeCalor * 4;
            particulas.forEach(p => {
                p.x += p.vx * velocidade;
                p.y += p.vy * velocidade;
                
                if (p.x < 0 || p.x > canvasNTC.width) p.vx *= -1;
                if (p.y < 0 || p.y > canvasNTC.height) p.vy *= -1;

                ctxNTC.fillStyle = '#FFD700';
                ctxNTC.shadowColor = '#FFD700';
                ctxNTC.shadowBlur = 10;
                ctxNTC.beginPath();
                ctxNTC.arc(p.x, p.y, p.raio, 0, Math.PI * 2);
                ctxNTC.fill();
                ctxNTC.shadowBlur = 0;
            });

            // Legenda
            ctxNTC.fillStyle = 'rgba(0,0,0,0.8)';
            ctxNTC.fillRect(10, 10, 220, 60);
            ctxNTC.fillStyle = 'white';
            ctxNTC.font = 'bold 14px sans-serif';
            ctxNTC.fillText(`Temperatura: ${temperaturaNTC}°C`, 20, 30);
            ctxNTC.font = '12px sans-serif';
            ctxNTC.fillText('● Amarelo = elétrons livres', 20, 50);
            ctxNTC.fillText('● Escuro = átomos da rede', 20, 65);

            requestAnimationFrame(desenharNTC);
        }

        sliderTempNTC.addEventListener('input', (e) => {
            temperaturaNTC = parseInt(e.target.value);
            valorTempNTC.textContent = temperaturaNTC + '°C';
            e.target.setAttribute('aria-valuenow', temperaturaNTC);
        });

        desenharNTC();

        /* ============================================
           SIMULADOR 2: COMPARAÇÃO DE SENSORES
           ============================================ */
        const canvasComp = document.getElementById('canvasComparacao');
        const ctxComp = canvasComp.getContext('2d');
        const sliderTempReal = document.getElementById('sliderTempReal');
        const valorTempReal = document.getElementById('valorTempReal');

        let tempReal = 25;
        let sensores = [
            { nome: 'Sensor Lento (Baixa Resolução)', leitura: 25, precisao: 1.0, inercia: 0.02, cor: '#f44336' },
            { nome: 'Sensor Médio', leitura: 25, precisao: 0.5, inercia: 0.1, cor: '#FF9F1C' },
            { nome: 'Sensor Rápido (Alta Resolução)', leitura: 25, precisao: 0.1, inercia: 0.3, cor: '#2EC4B6' }
        ];

        function desenharComparacao() {
            ctxComp.clearRect(0, 0, canvasComp.width, canvasComp.height);
            ctxComp.fillStyle = '#f8f9fa';
            ctxComp.fillRect(0, 0, canvasComp.width, canvasComp.height);

            // Atualizar leituras com inércia
            sensores.forEach((s, i) => {
                s.leitura += (tempReal - s.leitura) * s.inercia;
                // Arredondar pela resolução
                const leituraArred = Math.round(s.leitura / s.precisao) * s.precisao;
                
                const y = 60 + i * 80;
                
                // Barra de fundo
                ctxComp.fillStyle = '#e0e0e0';
                ctxComp.fillRect(250, y, 300, 40);
                
                // Barra do sensor
                const largura = ((leituraArred - 10) / 35) * 300;
                ctxComp.fillStyle = s.cor;
                ctxComp.fillRect(250, y, Math.max(0, largura), 40);
                
                // Nome do sensor
                ctxComp.fillStyle = '#212529';
                ctxComp.font = 'bold 13px sans-serif';
                ctxComp.textAlign = 'left';
                ctxComp.fillText(s.nome, 10, y + 25);
                
                // Valor lido
                ctxComp.fillStyle = 'white';
                ctxComp.font = 'bold 16px sans-serif';
                ctxComp.textAlign = 'center';
                ctxComp.fillText(leituraArred.toFixed(1) + '°C', 400, y + 26);
            });

            // Linha da temperatura real
            const xReal = 250 + ((tempReal - 10) / 35) * 300;
            ctxComp.strokeStyle = '#000';
            ctxComp.lineWidth = 2;
            ctxComp.setLineDash([5, 5]);
            ctxComp.beginPath();
            ctxComp.moveTo(xReal, 40);
            ctxComp.lineTo(xReal, 280);
            ctxComp.stroke();
            ctxComp.setLineDash([]);
            
            ctxComp.fillStyle = '#000';
            ctxComp.font = 'bold 12px sans-serif';
            ctxComp.textAlign = 'center';
            ctxComp.fillText('TEMPERATURA REAL', xReal, 35);

            // Escala
            ctxComp.fillStyle = '#666';
            ctxComp.font = '11px sans-serif';
            ctxComp.textAlign = 'center';
            for (let t = 10; t <= 45; t += 5) {
                const x = 250 + ((t - 10) / 35) * 300;
                ctxComp.fillText(t + '°C', x, 295);
            }

            requestAnimationFrame(desenharComparacao);
        }

        sliderTempReal.addEventListener('input', (e) => {
            tempReal = parseFloat(e.target.value);
            valorTempReal.textContent = tempReal.toFixed(1) + '°C';
            e.target.setAttribute('aria-valuenow', tempReal);
        });

        desenharComparacao();

        /* ============================================
           SIMULADOR 3: ESTRATIFICAÇÃO DA PISCINA
           ============================================ */
        const canvasPiscina = document.getElementById('canvasPiscina');
        const ctxPiscina = canvasPiscina.getContext('2d');
        const sliderSol = document.getElementById('sliderSol');
        const sliderBomba = document.getElementById('sliderBomba');
        const valorSol = document.getElementById('valorSol');
        const valorBomba = document.getElementById('valorBomba');

        let intensidadeSol = 70;
        let forcaBomba = 0;
        let camadas = [];
        const NUM_CAMADAS = 10;

        // Inicializar camadas com temperatura ambiente
        for (let i = 0; i < NUM_CAMADAS; i++) {
            camadas.push(22); // 22°C inicial
        }

        function desenharPiscina() {
            ctxPiscina.clearRect(0, 0, canvasPiscina.width, canvasPiscina.height);

            // Céu
            const gradCeu = ctxPiscina.createLinearGradient(0, 0, 0, 100);
            const brilhoSol = intensidadeSol / 100;
            gradCeu.addColorStop(0, `rgb(${135 + brilhoSol*50}, ${206 + brilhoSol*30}, ${235})`);
            gradCeu.addColorStop(1, `rgb(${200 + brilhoSol*55}, ${230}, ${255})`);
            ctxPiscina.fillStyle = gradCeu;
            ctxPiscina.fillRect(0, 0, canvasPiscina.width, 100);

            // Sol
            const raioSol = 30 + brilhoSol * 20;
            ctxPiscina.fillStyle = `rgba(255, ${180 + brilhoSol*75}, 0, ${0.5 + brilhoSol*0.5})`;
            ctxPiscina.shadowColor = '#FFD700';
            ctxPiscina.shadowBlur = 30 * brilhoSol;
            ctxPiscina.beginPath();
            ctxPiscina.arc(100, 60, raioSol, 0, Math.PI * 2);
            ctxPiscina.fill();
            ctxPiscina.shadowBlur = 0;

            // Raios do sol
            if (brilhoSol > 0.2) {
                ctxPiscina.strokeStyle = `rgba(255, 200, 0, ${brilhoSol * 0.5})`;
                ctxPiscina.lineWidth = 2;
                for (let i = 0; i < 8; i++) {
                    const angulo = (i / 8) * Math.PI * 2;
                    ctxPiscina.beginPath();
                    ctxPiscina.moveTo(100 + Math.cos(angulo) * (raioSol + 5), 60 + Math.sin(angulo) * (raioSol + 5));
                    ctxPiscina.lineTo(100 + Math.cos(angulo) * (raioSol + 20), 60 + Math.sin(angulo) * (raioSol + 20));
                    ctxPiscina.stroke();
                }
            }

            // Piscina (bordas)
            ctxPiscina.fillStyle = '#8B4513';
            ctxPiscina.fillRect(100, 100, 500, 20);
            ctxPiscina.fillRect(100, 100, 20, 280);
            ctxPiscina.fillRect(580, 100, 20, 280);
            ctxPiscina.fillRect(100, 380, 500, 20);

            // Água por camadas
            const alturaCamada = 260 / NUM_CAMADAS;
            for (let i = 0; i < NUM_CAMADAS; i++) {
                const temp = camadas[i];
                // Cor baseada na temperatura (azul frio -> vermelho quente)
                const t = Math.max(0, Math.min(1, (temp - 15) / 25));
                const r = Math.floor(50 + t * 200);
                const g = Math.floor(100 + (1 - Math.abs(t - 0.5) * 2) * 100);
                const b = Math.floor(220 - t * 180);
                ctxPiscina.fillStyle = `rgb(${r}, ${g}, ${b})`;
                ctxPiscina.fillRect(120, 120 + i * alturaCamada, 460, alturaCamada);

                // Label de temperatura
                ctxPiscina.fillStyle = 'white';
                ctxPiscina.font = 'bold 11px sans-serif';
                ctxPiscina.textAlign = 'right';
                ctxPiscina.fillText(temp.toFixed(1) + '°C', 570, 120 + i * alturaCamada + alturaCamada/2 + 4);
            }

            // Simulação física
            // Superfície aquece pelo sol
            const aquecimento = intensidadeSol * 0.0003;
            camadas[0] += aquecimento;
            
            // Perda de calor (radiação infravermelha) - mais forte nas camadas superiores
            const perda = 0.001;
            camadas.forEach((t, i) => {
                camadas[i] -= perda * (1 - i/NUM_CAMADAS) * (t - 15);
            });

            // Convecção natural (água quente sobe)
            for (let i = NUM_CAMADAS - 1; i > 0; i--) {
                if (camadas[i] > camadas[i-1] + 0.1) {
                    const diff = (camadas[i] - camadas[i-1]) * 0.01;
                    camadas[i] -= diff;
                    camadas[i-1] += diff;
                }
            }

            // Bomba de circulação (mistura forçada)
            if (forcaBomba > 0) {
                const mistura = forcaBomba * 0.005;
                let media = camadas.reduce((a, b) => a + b, 0) / NUM_CAMADAS;
                camadas.forEach((t, i) => {
                    camadas[i] += (media - t) * mistura;
                });
            }

            // Limites
            camadas = camadas.map(t => Math.max(10, Math.min(45, t)));

            // Desenhar bomba
            if (forcaBomba > 0) {
                ctxPiscina.fillStyle = '#333';
                ctxPiscina.fillRect(60, 200, 40, 60);
                ctxPiscina.fillStyle = '#FF9F1C';
                const rotacao = Date.now() / 100 * forcaBomba / 100;
                ctxPiscina.save();
                ctxPiscina.translate(80, 230);
                ctxPiscina.rotate(rotacao);
                ctxPiscina.fillRect(-15, -3, 30, 6);
                ctxPiscina.fillRect(-3, -15, 6, 30);
                ctxPiscina.restore();
                
                // Setas de circulação
                ctxPiscina.strokeStyle = 'rgba(255, 255, 255, 0.7)';
                ctxPiscina.lineWidth = 2;
                const t = Date.now() / 500;
                for (let i = 0; i < 3; i++) {
                    const y = 150 + ((t * 30 + i * 80) % 240);
                    ctxPiscina.beginPath();
                    ctxPiscina.moveTo(150, y);
                    ctxPiscina.lineTo(180, y);
                    ctxPiscina.lineTo(175, y - 5);
                    ctxPiscina.moveTo(180, y);
                    ctxPiscina.lineTo(175, y + 5);
                    ctxPiscina.stroke();
                }
            }

            // Sensores (3 pontos)
            const posicoesSensores = [0, Math.floor(NUM_CAMADAS/2), NUM_CAMADAS - 1];
            const labelsSensores = ['Sup', 'Meio', 'Fun'];
            posicoesSensores.forEach((pos, idx) => {
                const y = 120 + pos * alturaCamada + alturaCamada/2;
                ctxPiscina.fillStyle = '#000';
                ctxPiscina.fillRect(130, y - 5, 10, 10);
                ctxPiscina.fillStyle = 'white';
                ctxPiscina.font = 'bold 10px sans-serif';
                ctxPiscina.textAlign = 'left';
                ctxPiscina.fillText(labelsSensores[idx], 145, y + 3);
            });

            // Legenda
            ctxPiscina.fillStyle = 'rgba(0,0,0,0.7)';
            ctxPiscina.fillRect(10, 10, 180, 80);
            ctxPiscina.fillStyle = 'white';
            ctxPiscina.font = 'bold 12px sans-serif';
            ctxPiscina.textAlign = 'left';
            ctxPiscina.fillText('🌡️ Sensores:', 20, 30);
            ctxPiscina.font = '11px sans-serif';
            ctxPiscina.fillText(`Sup: ${camadas[0].toFixed(1)}°C`, 20, 50);
            ctxPiscina.fillText(`Meio: ${camadas[Math.floor(NUM_CAMADAS/2)].toFixed(1)}°C`, 20, 65);
            ctxPiscina.fillText(`Fundo: ${camadas[NUM_CAMADAS-1].toFixed(1)}°C`, 20, 80);

            requestAnimationFrame(desenharPiscina);
        }

        sliderSol.addEventListener('input', (e) => {
            intensidadeSol = parseInt(e.target.value);
            valorSol.textContent = intensidadeSol + '%';
            e.target.setAttribute('aria-valuenow', intensidadeSol);
        });

        sliderBomba.addEventListener('input', (e) => {
            forcaBomba = parseInt(e.target.value);
            valorBomba.textContent = forcaBomba === 0 ? 'Desligada' : forcaBomba + '%';
            e.target.setAttribute('aria-valuenow', forcaBomba);
        });

        function resetarSimulador() {
            camadas = camadas.map(() => 22);
            sliderSol.value = 70;
            sliderBomba.value = 0;
            intensidadeSol = 70;
            forcaBomba = 0;
            valorSol.textContent = '70%';
            valorBomba.textContent = 'Desligada';
        }

        desenharPiscina();
    </script>

